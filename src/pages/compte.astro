---
export const prerender = true;
import AuthLayout from "../layouts/AuthLayout.astro";

const iosAppStoreUrl =
  "https://apps.apple.com/fr/app/electronlibre-ia/id6743965549";
---

<AuthLayout
  title="Mon compte | ElectronLibre"
  description="Gérez votre abonnement ElectronLibre."
>
  <section class="el-archive-shell el-auth el-compte">
    <article class="el-auth__card el-compte__card">
      <h1 class="el-auth__title">Mon compte</h1>
      <p id="el-compte-sub" class="el-auth__sub">Chargement…</p>

      <div id="el-compte-guest" class="el-compte__block" hidden>
        <p>Connectez-vous pour gérer votre abonnement et votre mot de passe.</p>
        <p class="el-auth__links">
          <a class="btn-subscribe el-auth__submit" href="/login/?redirect=/compte/"
            >Connexion</a
          >
        </p>
        <p class="el-auth__foot">
          <a href="/abonnement/">S’abonner</a>
          <span aria-hidden="true">·</span>
          <a href="/">Accueil</a>
        </p>
      </div>

      <div id="el-compte-error" class="el-compte__block" hidden>
        <p id="el-compte-error-text">
          Impossible de charger votre espace pour le moment.
        </p>
        <p class="el-auth__links">
          <button type="button" class="btn-subscribe el-auth__submit" id="el-compte-retry">
            Réessayer
          </button>
        </p>
      </div>

      <div id="el-compte-app" hidden>
        <p
          id="el-compte-banner"
          class="el-compte__banner"
          hidden
        ></p>

        <section class="el-compte__section" aria-labelledby="el-compte-status">
          <h2 id="el-compte-status" class="el-compte__h2">Abonnement</h2>
          <dl class="el-compte__dl">
            <div>
              <dt>Statut</dt>
              <dd id="el-compte-status-val">—</dd>
            </div>
            <div>
              <dt>Formule</dt>
              <dd id="el-compte-plan-val">—</dd>
            </div>
            <div id="el-compte-until-row">
              <dt>Période en cours jusqu’au</dt>
              <dd id="el-compte-until-val">—</dd>
            </div>
          </dl>
        </section>

        <section
          class="el-compte__section"
          aria-labelledby="el-compte-manage"
          id="el-compte-manage-section"
        >
          <h2 id="el-compte-manage" class="el-compte__h2">
            Gestion de l’abonnement
          </h2>
          <p class="el-compte__app-lead" id="el-compte-portal-lead">
            Mettez à jour votre moyen de paiement, téléchargez vos factures ou
            résiliez votre abonnement.
          </p>
          <div class="el-compte__actions" id="el-compte-portal-actions">
            <button type="button" class="btn-subscribe" id="el-compte-portal">
              Abonnement, factures
            </button>
            <a class="el-auth__textbtn" href="/abonnement/" id="el-compte-renew"
              >Voir les formules</a
            >
          </div>
          <p class="el-compte__app-lead" id="el-compte-manage-manual" hidden>
            Abonnement annuel&nbsp;: pour une facture ou un changement, écrivez
            à
            <a href="mailto:info@electronlibre.info"
              >info@electronlibre.info</a
            >.
          </p>
          <p id="el-compte-portal-msg" class="el-auth__error" hidden></p>
        </section>

        <section class="el-compte__section" aria-labelledby="el-compte-ids">
          <h2 id="el-compte-ids" class="el-compte__h2">Identifiants</h2>
          <dl class="el-compte__dl">
            <div id="el-compte-login-row" hidden>
              <dt>Identifiant</dt>
              <dd id="el-compte-login-val">—</dd>
            </div>
            <div>
              <dt>E-mail de connexion</dt>
              <dd id="el-compte-email-val">—</dd>
            </div>
          </dl>
          <p class="el-compte__app-lead" id="el-compte-login-hint">
            Connectez-vous avec votre e-mail (site et app).
          </p>
        </section>

        <section class="el-compte__section" aria-labelledby="el-compte-nl">
          <h2 id="el-compte-nl" class="el-compte__h2">Newsletter</h2>
          <label class="el-compte__check">
            <input type="checkbox" id="el-compte-nl-check" />
            Recevoir la newsletter quotidienne
          </label>
          <p id="el-compte-nl-msg" class="el-compte__ok" hidden></p>
        </section>

        <section class="el-compte__section" aria-labelledby="el-compte-app-ios">
          <h2 id="el-compte-app-ios" class="el-compte__h2">Application iOS</h2>
          <p class="el-compte__app-lead">
            Suivez l’actualité et les alertes ElectronLibre en mobilité.
          </p>
          <div class="el-compte__actions">
            <a
              class="btn-subscribe el-compte__app-cta"
              href={iosAppStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              >Installer l’app</a
            >
          </div>
        </section>

        <section class="el-compte__section" aria-labelledby="el-compte-pwd">
          <h2 id="el-compte-pwd" class="el-compte__h2">Mot de passe</h2>
          <p class="el-compte__app-lead">
            Ce mot de passe sert à vous connecter sur le site et dans l’application
            iOS. Sans connexion, l’app ne pourra pas afficher l’ensemble des contenus
            ni ouvrir EL Compagnon.
          </p>
          <form id="el-compte-pwd-form" class="el-auth__form">
            <label for="el-compte-pwd-input">Nouveau mot de passe</label>
            <input
              id="el-compte-pwd-input"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              placeholder="8 caractères minimum"
            />
            <p id="el-compte-pwd-msg" class="el-auth__error" hidden></p>
            <p id="el-compte-pwd-ok" class="el-compte__ok" hidden></p>
            <button type="submit" class="btn-subscribe el-auth__submit">
              Mettre à jour
            </button>
          </form>
        </section>

        <p class="el-auth__foot">
          <button type="button" class="el-auth__textbtn" id="el-compte-logout">
            Déconnexion
          </button>
          <span aria-hidden="true">·</span>
          <a href="/">Accueil</a>
        </p>
      </div>
    </article>
  </section>
</AuthLayout>

<script is:inline>
  (function () {
    var guest = document.getElementById("el-compte-guest");
    var app = document.getElementById("el-compte-app");
    var errBox = document.getElementById("el-compte-error");
    var sub = document.getElementById("el-compte-sub");
    var banner = document.getElementById("el-compte-banner");
    var params = new URLSearchParams(location.search);
    if (params.get("checkout") === "success") {
      banner.textContent =
        "Paiement reçu — votre accès est ouvert. Vérifiez votre e-mail pour choisir un mot de passe et vous connecter.";
      banner.hidden = false;
    }

    function showGuest() {
      guest.hidden = false;
      app.hidden = true;
      if (errBox) errBox.hidden = true;
    }
    function showError(msg) {
      guest.hidden = true;
      app.hidden = true;
      if (errBox) {
        errBox.hidden = false;
        var t = document.getElementById("el-compte-error-text");
        if (t && msg) t.textContent = msg;
      }
    }
    function showApp() {
      guest.hidden = true;
      if (errBox) errBox.hidden = true;
      app.hidden = false;
    }

    function formatDate(iso) {
      if (!iso) return "Sans limite";
      try {
        return new Date(iso).toLocaleDateString("fr-FR", {
          day: "numeric",
          month: "long",
          year: "numeric",
        });
      } catch (e) {
        return String(iso);
      }
    }

    function isStaffRole(role) {
      return role === "admin" || role === "editor" || role === "author";
    }

    function planLabel(plan, stripe, role) {
      if (isStaffRole(role)) return "Compte équipe";
      if (plan === "monthly" || stripe) return "Mensuel en ligne (100 €)";
      if (plan === "annual_manual") return "Annuel (900 €)";
      return plan || "—";
    }

    function statusLabel(account) {
      if (!account) return "—";
      if (isStaffRole(account.role)) return "Actif (équipe)";
      if (account.entitled) return "Actif";
      if (account.status === "expired") return "Expiré";
      if (account.status === "disabled") return "Désactivé";
      return account.status || "—";
    }

    async function load() {
      try {
        var meRes = await fetch("/api/auth/me", { credentials: "same-origin" });
        var me = await meRes.json();
        if (!me.authenticated) {
          sub.textContent = "Espace abonné";
          showGuest();
          return;
        }
        var billRes = await fetch("/api/billing/me", {
          credentials: "same-origin",
        });
        var bill = await billRes.json().catch(function () {
          return {};
        });
        if (!billRes.ok) {
          sub.textContent = me.user?.name || me.user?.login || "Mon compte";
          showError(
            bill.error ||
              "Impossible de charger les informations d’abonnement. Réessayez."
          );
          return;
        }
        var a = bill.account || me.user || {};
        sub.textContent = a.name || a.login || "Espace abonné";
        showApp();
        var isStaff = isStaffRole(a.role);
        document.getElementById("el-compte-status-val").textContent =
          statusLabel(a);
        document.getElementById("el-compte-plan-val").textContent = planLabel(
          a.plan,
          a.stripe,
          a.role
        );
        var untilRow = document.getElementById("el-compte-until-row");
        if (untilRow) untilRow.hidden = isStaff;
        document.getElementById("el-compte-until-val").textContent = isStaff
          ? "—"
          : formatDate(a.access_until);
        var emailVal = a.billing_email || a.email || "—";
        var loginVal = a.login || "";
        var loginRow = document.getElementById("el-compte-login-row");
        var loginHint = document.getElementById("el-compte-login-hint");
        document.getElementById("el-compte-email-val").textContent = emailVal;
        document.getElementById("el-compte-login-val").textContent =
          loginVal || "—";
        var sameLogin =
          loginVal &&
          emailVal &&
          String(loginVal).toLowerCase() === String(emailVal).toLowerCase();
        if (loginRow) loginRow.hidden = !loginVal || sameLogin;
        if (loginHint) {
          loginHint.textContent = sameLogin || !loginVal
            ? "Connectez-vous avec votre e-mail (site et app)."
            : "Connexion possible avec l’identifiant ou l’e-mail (site et app).";
        }
        var manageSection = document.getElementById("el-compte-manage-section");
        var portalBtn = document.getElementById("el-compte-portal");
        var portalLead = document.getElementById("el-compte-portal-lead");
        var portalActions = document.getElementById("el-compte-portal-actions");
        var manageManual = document.getElementById("el-compte-manage-manual");
        var renewLink = document.getElementById("el-compte-renew");
        var canPortal = !isStaff && !!a.canManageBilling;
        var isAnnual = !isStaff && a.plan === "annual_manual" && !canPortal;
        if (manageSection) manageSection.hidden = isStaff;
        if (portalBtn) portalBtn.hidden = !canPortal;
        if (portalLead) portalLead.hidden = !canPortal;
        if (manageManual) manageManual.hidden = !isAnnual;
        if (portalActions) {
          portalActions.hidden = !canPortal && isAnnual;
        }
        if (renewLink) {
          renewLink.hidden = canPortal || isAnnual || isStaff;
        }
        if (!isStaff && !canPortal && !isAnnual && portalActions) {
          portalActions.hidden = false;
          if (portalLead) {
            portalLead.hidden = false;
            portalLead.textContent =
              "Souscrivez en ligne pour gérer paiement, factures et résiliation depuis cet espace.";
          }
        }
        var nl = document.getElementById("el-compte-nl-check");
        nl.checked = !!a.newsletter_opt_in;
      } catch (e) {
        sub.textContent = "Erreur de chargement";
        showError("Erreur réseau. Vérifiez votre connexion puis réessayez.");
      }
    }

    document
      .getElementById("el-compte-retry")
      ?.addEventListener("click", function () {
        sub.textContent = "Chargement…";
        load();
      });

    document
      .getElementById("el-compte-portal")
      ?.addEventListener("click", async function () {
        var msg = document.getElementById("el-compte-portal-msg");
        msg.hidden = true;
        try {
          var res = await fetch("/api/billing/portal", {
            method: "POST",
            credentials: "same-origin",
          });
          var data = await res.json().catch(function () {
            return {};
          });
          if (!res.ok || !data.url) {
            msg.textContent =
              data.error || "Portail indisponible pour le moment.";
            msg.hidden = false;
            return;
          }
          location.href = data.url;
        } catch (e) {
          msg.textContent = "Erreur réseau.";
          msg.hidden = false;
        }
      });

    document
      .getElementById("el-compte-nl-check")
      ?.addEventListener("change", async function (e) {
        var ok = document.getElementById("el-compte-nl-msg");
        ok.hidden = true;
        try {
          var res = await fetch("/api/billing/me", {
            method: "PATCH",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ newsletter_opt_in: !!e.target.checked }),
          });
          if (res.ok) {
            ok.textContent = "Préférence enregistrée.";
            ok.hidden = false;
          }
        } catch (ex) {}
      });

    document
      .getElementById("el-compte-pwd-form")
      ?.addEventListener("submit", async function (e) {
        e.preventDefault();
        var err = document.getElementById("el-compte-pwd-msg");
        var ok = document.getElementById("el-compte-pwd-ok");
        err.hidden = true;
        ok.hidden = true;
        var password = document.getElementById("el-compte-pwd-input").value;
        try {
          var res = await fetch("/api/billing/password", {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ password: password }),
          });
          var data = await res.json().catch(function () {
            return {};
          });
          if (!res.ok) {
            err.textContent = data.error || "Échec";
            err.hidden = false;
            return;
          }
          ok.textContent = data.message || "Mot de passe mis à jour.";
          ok.hidden = false;
          e.target.reset();
        } catch (ex) {
          err.textContent = "Erreur réseau.";
          err.hidden = false;
        }
      });

    document
      .getElementById("el-compte-logout")
      ?.addEventListener("click", async function () {
        await fetch("/api/auth/logout", {
          method: "POST",
          credentials: "same-origin",
        });
        location.href = "/";
      });

    load();
  })();
</script>
