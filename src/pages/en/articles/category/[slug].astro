---
export const prerender = false;

import CategoryArchive from "../../../../components/CategoryArchive.astro";
import { prepareCategoryArchive } from "../../../../lib/archive";

const result = await prepareCategoryArchive(Astro.params.slug, "en", 1);
if ("redirect" in result) return Astro.redirect(result.redirect);
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, stale-while-revalidate=60"
);
---

<CategoryArchive {...result} />
