---
export const prerender = false;

import TagArchive from "../../../../components/TagArchive.astro";
import { prepareTagArchive } from "../../../../lib/archive";

const result = await prepareTagArchive(Astro.params.slug, "en");
if ("redirect" in result) return Astro.redirect(result.redirect);
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, stale-while-revalidate=60"
);
---

<TagArchive {...result} />
