---
export const prerender = false;

import HomeArchive from "../../../components/HomeArchive.astro";
import { prepareHomeArchive } from "../../../lib/archive";

const result = await prepareHomeArchive("en", Number(Astro.params.n || 2), {
  paginated: true,
});
if ("redirect" in result) return Astro.redirect(result.redirect);
Astro.response.headers.set("Cache-Control", result.cache);
---

<HomeArchive {...result} />
