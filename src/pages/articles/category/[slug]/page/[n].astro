---
export const prerender = false;

import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import ArchiveList from "../../../../../components/ArchiveList.astro";
import {
  categoryArchiveBase,
  categoryArchivePath,
  getCategoryArchivePage,
} from "../../../../../lib/archive";
import { CATEGORIES, categoryName } from "../../../../../lib/categories";

const { slug } = Astro.params;
const n = Number(Astro.params.n || 2);

if (!slug || !CATEGORIES.some((c) => c.slug === slug)) {
  return Astro.redirect("/404/");
}
if (!Number.isFinite(n) || n < 2) {
  return Astro.redirect(categoryArchivePath(slug, 1));
}

const name = categoryName(slug);
const { featured, rest, page, totalPages } = await getCategoryArchivePage(
  slug,
  "fr",
  n
);

if (page !== n) {
  return Astro.redirect(categoryArchivePath(slug, page));
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=30, stale-while-revalidate=60"
);

const title =
  page > 1 ? `${name} — page ${page} | ElectronLibre` : `${name} | ElectronLibre`;
---

<BaseLayout title={title} description={`Articles — ${name}`}>
  <ArchiveList
    title={name}
    featured={featured}
    rest={rest}
    page={page}
    totalPages={totalPages}
    lang="fr"
    basePath={categoryArchiveBase(slug)}
    emptyMessage="Aucun article importé dans cette catégorie pour l’instant."
  />
</BaseLayout>
