---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import {
  getArticleByIdSlug,
  articleIdSlug,
  articlePath,
  isFreeArticle,
  getRelatedArticles,
  getTranslationUrls,
  formatArchiveDate,
  humanizeTag,
} from "../../lib/articles";
import { ASSET_V } from "../../lib/assets";

const idSlug = Astro.params.idSlug || "";
const article = await getArticleByIdSlug(idSlug);
if (!article) {
  return new Response("Article introuvable", { status: 404 });
}

const canonicalSlug = articleIdSlug(article);
if (idSlug !== canonicalSlug) {
  return Astro.redirect(articlePath(article), 301);
}

const pageLang = (article.data.lang || "fr").toLowerCase() === "en" ? "en" : "fr";
const [related, translationUrls] = await Promise.all([
  getRelatedArticles(article, 3),
  getTranslationUrls(article),
]);

const free = isFreeArticle(article);
const d = article.data;
const homeHref = pageLang === "en" ? "/en/" : "/";
const homeLabel = pageLang === "en" ? "Home" : "Accueil";
const relatedTitle =
  pageLang === "en" ? "Related reading..." : "A lire aussi...";
const keywordsTitle = pageLang === "en" ? "Keywords" : "Mots-clés";
const dateLabel = formatArchiveDate(d.date);
const primaryCat = {
  slug: d.categories[0] || "",
  name: d.category_names[0] || "Article",
};
const cats = d.categories.map((slug, i) => ({
  slug,
  name: d.category_names[i] || slug,
}));
const tags = (d.tags || []).slice(0, 24);
const iaKeywords = (d.ia_keywords || []).slice(0, 24);
const href = articlePath(article);
const hasTranslations =
  Boolean(translationUrls?.FR) && Boolean(translationUrls?.EN);
const currentLangCode = pageLang === "en" ? "EN" : "FR";

// Paywall : jamais de cache public (évite de servir un HTML « unlocked » par erreur)
Astro.response.headers.set(
  "Cache-Control",
  free
    ? "public, max-age=30, stale-while-revalidate=60"
    : "private, no-store"
);
---

<BaseLayout
  title={`${d.title} | ElectronLibre`}
  description={d.excerpt}
  lang={pageLang}
  bodyClass="el-single-page"
  ogType="article"
>
  <div class="el-archive-shell el-single-shell">
    <nav class="el-breadcrumb" aria-label="Fil d'Ariane">
      <ol class="el-breadcrumb__list">
        <li class="el-breadcrumb__item">
          <a class="el-breadcrumb__link" href={homeHref}>{homeLabel}</a>
        </li>
        {
          primaryCat.slug && (
            <li class="el-breadcrumb__item">
              <a
                class="el-breadcrumb__link"
                href={`/articles/category/${primaryCat.slug}/`}
              >
                {primaryCat.name}
              </a>
            </li>
          )
        }
        <li class="el-breadcrumb__item">
          <span class="el-breadcrumb__current">{d.title}</span>
        </li>
      </ol>
    </nav>

    <header class="el-section-head el-single-section-head">
      <p class="el-section-head__title">
        {
          primaryCat.slug ? (
            <a href={`/articles/category/${primaryCat.slug}/`}>{primaryCat.name}</a>
          ) : (
            primaryCat.name
          )
        }
      </p>
    </header>

    <div class="archive-wrapper">
      <div class="el-single-layout">
        <div class="el-single-main">
          {
            hasTranslations && (
              <div id="language-selector">
                <label class="screen-reader-text" for="el-article-lang">
                  {pageLang === "en" ? "Article language" : "Langue de l’article"}
                </label>
                <select
                  id="el-article-lang"
                  onchange="location = this.value;"
                >
                  <option
                    value={translationUrls.FR}
                    selected={currentLangCode === "FR" ? true : undefined}
                  >
                    🇫🇷 FR
                  </option>
                  <option
                    value={translationUrls.EN}
                    selected={currentLangCode === "EN" ? true : undefined}
                  >
                    🇬🇧 EN
                  </option>
                </select>
              </div>
            )
          }
          <article
            class="news-snippet el-single-article-card"
            data-wp-id={d.wp_id}
            data-access={d.access}
          >
            <div class="ihead info">
              <ul class="list-inline">
                <li>
                  <time datetime={d.date.toISOString()}>{dateLabel}</time>
                </li>
                {
                  d.author && (
                    <li class="post-author">
                      <span>{d.author}</span>
                    </li>
                  )
                }
              </ul>
            </div>

            <h1 class="news-title page-title">{d.title}</h1>

            {
              cats.length > 0 && (
                <div class="category">
                  {cats.map((c) => (
                    <a href={`/articles/category/${c.slug}/`}>{c.name}</a>
                  ))}
                </div>
              )
            }

            {
              free ? (
                <div class="inner-article-content entry-content" set:html={article.body} />
              ) : (
                <div id="el-paywall-root" data-wp-id={d.wp_id}>
                  <div class="el-article__teaser">
                    {d.excerpt && <p class="seo-teaser-ai">{d.excerpt}</p>}
                    <div class="el-paywall abonnement-cta">
                      <p>
                        {pageLang === "en"
                          ? "This article is reserved for ElectronLibre subscribers."
                          : "Cet article est réservé aux abonnés ElectronLibre."}
                      </p>
                      <a
                        class="btn-subscribe"
                        href={`/login/?redirect=${encodeURIComponent(href)}`}
                      >
                        {pageLang === "en" ? "Log in" : "Connexion"}
                      </a>
                      <a class="btn-subscribe" href="/abonnement/">
                        {pageLang === "en" ? "Subscribe" : "Je m’abonne"}
                      </a>
                    </div>
                  </div>
                </div>
              )
            }

            {
              tags.length > 0 && (
                <div class="ifoot info">
                  <div class="tags">
                    {tags.map((t) => (
                      <a href={`/articles/tag/${encodeURIComponent(t)}/`}>
                        {humanizeTag(t)}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }
          </article>

          {
            related.length > 0 && (
              <section class="related-posts el-related" aria-label={relatedTitle}>
                <header class="el-section-head">
                  <h2 class="el-section-head__title el-related__title">
                    {relatedTitle}
                  </h2>
                </header>
                <div class="el-card-grid blog-grid-view el-related-grid">
                  {related.map((a) => (
                    <ArticleCard article={a} variant="related" />
                  ))}
                </div>
              </section>
            )
          }
        </div>

        {
          iaKeywords.length > 0 && (
            <aside class="el-single-sidebar" aria-label={keywordsTitle}>
              <div id="secondary">
                <h2 class="el-single-aside__title">{keywordsTitle}</h2>
                {/* Corps article chargé via /api/content — jamais en base64 dans le HTML */}
                <div class="tags el-ia-keywords" data-wp-id={d.wp_id}>
                  {iaKeywords.map((k) => (
                    <button
                      type="button"
                      class="keyword-item el-ia-keyword"
                      data-keyword={k}
                    >
                      {k}
                    </button>
                  ))}
                </div>
                <div
                  id="ai-definition-container"
                  class="ai-definition"
                  aria-live="polite"
                />
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </div>
  <script is:inline src={`/js/el-ia-keywords.js?v=${ASSET_V}`}></script>
</BaseLayout>
