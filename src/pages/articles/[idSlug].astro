---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import HomeTools from "../../components/HomeTools.astro";
import KeywordTags from "../../components/KeywordTags.astro";
import {
  getArticleByIdSlug,
  articleIdSlug,
  articlePath,
  isFreeArticle,
  getRelatedArticles,
  getTranslationUrls,
  formatArchiveDate,
  formatUpdateDateTime,
  articleUpdateDate,
  displayKeyword,
  articleDisplayKeywords,
} from "../../lib/articles";
import { ASSET_V } from "../../lib/assets";
import { chrome, pagePath, resolveLang } from "@el/i18n-seo";
import LangSwitcher from "../../components/LangSwitcher.astro";

const idSlug = Astro.params.idSlug || "";
const article = await getArticleByIdSlug(idSlug);
if (!article) {
  return new Response("Article introuvable", { status: 404 });
}

const canonicalSlug = articleIdSlug(article);
if (idSlug !== canonicalSlug) {
  return Astro.redirect(articlePath(article), 301);
}

const pageLang = resolveLang(article.data.lang);
const [related, translationUrls] = await Promise.all([
  getRelatedArticles(article, 3),
  getTranslationUrls(article),
]);

const free = isFreeArticle(article);
const d = article.data;
const homeHref = pagePath("home", pageLang);
const homeLabel = chrome("homeLabel", pageLang);
const relatedTitle = chrome("related", pageLang);
const browseTitle = chrome("browseTitle", pageLang);
const browseHint = chrome("browseHint", pageLang);
const defineTitle = chrome("defineTitle", pageLang);
const defineHelp = chrome("defineHelp", pageLang);
const dateLabel = formatArchiveDate(d.date, pageLang);
const updateDate = articleUpdateDate(article);
const updateLabel = updateDate
  ? formatUpdateDateTime(updateDate, pageLang)
  : "";
const updatePrefix = chrome("updatePrefix", pageLang);
const primaryCat = {
  slug: d.categories[0] || "",
  name: d.category_names[0] || "Article",
};
const cats = d.categories.map((slug, i) => ({
  slug,
  name: d.category_names[i] || slug,
}));
// Sujets liés + cards : IA (abonnés) si présent, sinon tags WP
const browseKeywords = articleDisplayKeywords(article, 0);
// Sidebar « Définir » : mots-clés IA abonnés uniquement
const iaKeywords = (!free ? d.ia_keywords || [] : []).slice(0, 24);
const href = articlePath(article);
const hasTranslations =
  Boolean(translationUrls?.FR) && Boolean(translationUrls?.EN);

// Paywall : jamais de cache public. Articles gratuits : revalidation rapide
// (mots-clés / métadonnées éditées dans le pupitre doivent apparaître tout de suite).
Astro.response.headers.set(
  "Cache-Control",
  free
    ? "public, max-age=0, must-revalidate"
    : "private, no-store"
);
---

<BaseLayout
  title={`${d.title} | ElectronLibre`}
  description={d.excerpt}
  lang={pageLang}
  bodyClass="el-single-page"
  ogType="article"
  alternates={{
    fr: translationUrls.FR,
    en: translationUrls.EN,
  }}
  hreflangContext="article"
>
  <div class="el-archive-shell el-single-shell">
    <nav class="el-breadcrumb" aria-label={chrome("breadcrumb", pageLang)}>
      <ol class="el-breadcrumb__list">
        <li class="el-breadcrumb__item">
          <a class="el-breadcrumb__link" href={homeHref}>{homeLabel}</a>
        </li>
        {
          primaryCat.slug && (
            <li class="el-breadcrumb__item">
              <a
                class="el-breadcrumb__link"
                href={pagePath("category", pageLang, { slug: primaryCat.slug })}
              >
                {primaryCat.name}
              </a>
            </li>
          )
        }
        <li class="el-breadcrumb__item">
          <span class="el-breadcrumb__current">{d.title}</span>
        </li>
      </ol>
    </nav>

    <header class="el-section-head el-single-section-head">
      <p class="el-section-head__title">
        {
          primaryCat.slug ? (
            <a href={pagePath("category", pageLang, { slug: primaryCat.slug })}>{primaryCat.name}</a>
          ) : (
            primaryCat.name
          )
        }
      </p>
    </header>

    <div class="archive-wrapper">
      <div class="el-single-layout">
        <div class="el-single-main">
          {
            hasTranslations && (
              <LangSwitcher
                lang={pageLang}
                hrefs={{ fr: translationUrls.FR!, en: translationUrls.EN! }}
                context="article"
              />
            )
          }
          <article
            class="news-snippet el-single-article-card"
            data-article-id={d.article_id}
            data-access={d.access}
          >
            <div class="ihead info">
              <ul class="list-inline">
                <li>
                  <time datetime={d.date.toISOString()}>{dateLabel}</time>
                </li>
                {
                  d.author && (
                    <li class="post-author">
                      <span>{d.author}</span>
                    </li>
                  )
                }
              </ul>
              {
                updateDate && (
                  <p class="post-updated">
                    <time datetime={updateDate.toISOString()}>
                      {updatePrefix} {updateLabel}
                    </time>
                  </p>
                )
              }
            </div>

            <h1 class="news-title page-title">{d.title}</h1>

            {
              cats.length > 0 && (
                <div class="category">
                  {cats.map((c) => (
                    <a href={pagePath("category", pageLang, { slug: c.slug })}>{c.name}</a>
                  ))}
                </div>
              )
            }

            {
              free ? (
                <div
                  class="inner-article-content entry-content"
                  set:html={article.body}
                />
              ) : (
                <div id="el-paywall-root" data-article-id={d.article_id}>
                  <div class="el-article__teaser">
                    {d.excerpt && (
                      <p class="el-article-chapo el-article-chapo--teaser">
                        {d.excerpt}
                      </p>
                    )}
                    <div class="el-paywall abonnement-cta">
                      <p>
                        {chrome("paywall", pageLang)}
                      </p>
                      <a
                        class="btn-subscribe"
                        href={`/login/?redirect=${encodeURIComponent(href)}`}
                      >
                        {chrome("login", pageLang)}
                      </a>
                      <a class="btn-subscribe" href="/abonnement/">
                        {chrome("subscribeCta", pageLang)}
                      </a>
                    </div>
                  </div>
                </div>
              )
            }

            {
              browseKeywords.length > 0 && (
                <div class="ifoot info el-keywords-browse-block" aria-label={browseTitle}>
                  <p class="el-keywords-browse__label">{browseTitle}</p>
                  <p class="el-keywords-browse__help">{browseHint}</p>
                  <KeywordTags
                    keywords={browseKeywords}
                    class="tags el-keywords-browse"
                    linkTitle={browseHint}
                    lang={pageLang}
                  />
                </div>
              )
            }
          </article>

          {
            related.length > 0 && (
              <section class="related-posts el-related" aria-label={relatedTitle}>
                <header class="el-section-head">
                  <h2 class="el-section-head__title el-related__title">
                    {relatedTitle}
                  </h2>
                </header>
                <div class="el-card-grid blog-grid-view el-related-grid">
                  {related.map((a) => (
                    <ArticleCard article={a} variant="related" lang={pageLang} />
                  ))}
                </div>
              </section>
            )
          }
        </div>

        <div class="el-single-aside-col">
          {
            iaKeywords.length > 0 && (
              <aside class="el-single-sidebar" aria-label={defineTitle}>
                <header class="el-section-head el-single-sidebar-head">
                  <h2 class="el-section-head__title el-single-aside__title">
                    {defineTitle}
                  </h2>
                </header>
                <div id="secondary">
                  <p class="el-keywords-define__help">{defineHelp}</p>
                  {/* Corps article chargé via /api/content — jamais en base64 dans le HTML */}
                  <div
                    class="tags el-ia-keywords"
                    data-article-id={d.article_id}
                    data-title={d.title}
                    data-excerpt={d.excerpt || ""}
                  >
                    {iaKeywords.map((k) => (
                      <button
                        type="button"
                        class="keyword-item el-ia-keyword"
                        data-keyword={k}
                        title={defineHelp}
                      >
                        {displayKeyword(k)}
                      </button>
                    ))}
                  </div>
                  <div
                    id="ai-definition-container"
                    class="ai-definition"
                    aria-live="polite"
                  />
                </div>
              </aside>
            )
          }
          <HomeTools lang={pageLang} />
        </div>
      </div>
    </div>
  </div>
  <script is:inline src={`/js/el-ia-keywords.js?v=${ASSET_V}`}></script>
</BaseLayout>
