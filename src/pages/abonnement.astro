---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Abonnement à ElectronLibre";
const description =
  "Abonnement ElectronLibre : information et documents exclusifs sur le numérique, la réglementation, l’économie et les nouvelles technologies. 100 € / mois ou devis annuel 900 €.";
const mailtoSubscribe =
  "mailto:info@electronlibre.info?subject=" +
  encodeURIComponent("Devis abonnement annuel ElectronLibre (900 €)");
const mailtoQuestion =
  "mailto:info@electronlibre.info?subject=" +
  encodeURIComponent("Question abonnement ElectronLibre");
---

<BaseLayout
  title={`${title} | ElectronLibre`}
  description={description}
  bodyClass="el-archive-surface el-subscribe-page"
>
  <section class="el-archive-shell el-subscribe">
    <header class="el-section-head">
      <h1 class="el-section-head__title">Abonnement</h1>
    </header>

    <article class="el-subscribe__card">
      <div class="el-subscribe__hero">
        <h2 class="el-subscribe__title">
          L’information exclusive du numérique, pour les professionnels
        </h2>
        <p class="el-subscribe__lead" set:html={`Accédez à une <strong>information exclusive</strong> et à des <strong>documents réservés</strong> aux abonnés&nbsp;: analyses de l’industrie et de la culture numérique, suivi de la réglementation et des lois, lectures sur l’économie, la politique et les nouvelles technologies. Chaque jour, la newsletter vous livre l’essentiel&nbsp;; l’application iOS vous alerte en mobilité&nbsp;; <strong>EL Compagnon</strong>, l’assistant IA réservé aux abonnés, vous aide à explorer et croiser ces contenus.`} />
      </div>

      <section class="el-subscribe__benefits" aria-labelledby="el-subscribe-why">
        <h3 id="el-subscribe-why" class="el-subscribe__block-title">
          Pourquoi s’abonner&nbsp;?
        </h3>
        <ul class="el-subscribe__list">
          <li>Une veille claire pour décider plus vite</li>
          <li>Le contexte réglementaire et politique, décrypté</li>
          <li>Des dossiers et archives au-delà de l’actualité du jour</li>
          <li>Un accès unifié web, mobile et assistant IA</li>
        </ul>
      </section>

      <section
        class="el-subscribe__plans"
        aria-labelledby="el-subscribe-plans"
      >
        <h3 id="el-subscribe-plans" class="el-subscribe__block-title">
          Choisir une formule
        </h3>
        <div class="el-subscribe__plans-grid">
          <div class="el-subscribe__plan el-subscribe__plan--monthly">
            <div class="el-subscribe__plan-visual">
              <span class="el-subscribe__plan-visual-kicker"
                >10&nbsp;jours d’essai offerts</span
              >
              <span class="el-subscribe__plan-visual-price">100&nbsp;€</span>
              <span class="el-subscribe__plan-visual-unit">par mois</span>
            </div>
            <p class="el-subscribe__plan-eyebrow">En ligne · CB ou PayPal</p>
            <h4 class="el-subscribe__plan-name">Mensuel</h4>
            <p class="el-subscribe__plan-tagline">
              Sans engagement — résiliez quand vous voulez.
            </p>
            <ul class="el-subscribe__plan-perks">
              <li>Articles &amp; rapports en illimité</li>
              <li>EL Compagnon + app iOS</li>
              <li>Newsletter quotidienne incluse</li>
            </ul>
            <form id="el-checkout-form" class="el-subscribe__checkout" novalidate>
              <div class="el-subscribe__name-row">
                <div class="el-subscribe__field">
                  <label for="el-co-given">Prénom</label>
                  <input
                    id="el-co-given"
                    name="given-name"
                    type="text"
                    autocomplete="given-name"
                    autocapitalize="words"
                    spellcheck="false"
                    enterkeyhint="next"
                    required
                    placeholder="Steve"
                  />
                </div>
                <div class="el-subscribe__field">
                  <label for="el-co-family">Nom</label>
                  <input
                    id="el-co-family"
                    name="family-name"
                    type="text"
                    autocomplete="family-name"
                    autocapitalize="words"
                    spellcheck="false"
                    enterkeyhint="next"
                    required
                    placeholder="Jobs"
                  />
                </div>
              </div>
              <label for="el-co-email">E-mail professionnel</label>
              <input
                id="el-co-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="votre@email"
              />
              <!-- honeypot anti-spam -->
              <div class="el-subscribe__hp" aria-hidden="true">
                <label for="el-co-website">Site web</label>
                <input
                  id="el-co-website"
                  name="website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
              <p class="el-subscribe__form-info">
                Sans engagement, résiliable à tout moment depuis votre espace.
              </p>
              <p id="el-checkout-error" class="el-subscribe__form-error" hidden>
              </p>
              <button
                type="submit"
                class="btn-subscribe el-subscribe__cta el-subscribe__cta--monthly"
                id="el-checkout-btn"
                disabled
              >
                …
              </button>
            </form>
          </div>

          <div class="el-subscribe__plan el-subscribe__plan--annual">
            <p class="el-subscribe__save-badge">
              Économisez <strong>300&nbsp;€</strong>
            </p>
            <p class="el-subscribe__plan-eyebrow">Meilleur tarif</p>
            <h4 class="el-subscribe__plan-name">Annuel</h4>
            <p class="el-subscribe__plan-price el-subscribe__plan-price--stack">
              <span class="el-subscribe__plan-was"
                ><span class="el-subscribe__sr">Au lieu de </span
                >1&nbsp;200&nbsp;€</span
              >
              <span class="el-subscribe__plan-now">
                <span class="el-subscribe__plan-amount">900&nbsp;€</span>
                <span class="el-subscribe__plan-period">/ an</span>
              </span>
            </p>
            <p class="el-subscribe__plan-equiv">
              Soit <strong>75&nbsp;€ / mois</strong> — 25&nbsp;% de moins que
              12 × 100&nbsp;€.
            </p>
            <p class="el-subscribe__plan-note">
              Même accès premium, newsletter quotidienne incluse. Compte et
              facture annuelle après votre devis.
            </p>
            <a
              class="btn-subscribe el-subscribe__cta el-subscribe__cta--annual"
              href={mailtoSubscribe}
              >Demandez un devis</a
            >
          </div>
        </div>
      </section>

      <section class="el-subscribe__how" aria-labelledby="el-subscribe-how">
        <h3 id="el-subscribe-how" class="el-subscribe__block-title">
          Après l’inscription en ligne
        </h3>
        <p>
          Votre compte est créé automatiquement dès le checkout. Un e-mail vous
          permet de choisir votre mot de passe&nbsp;; l’accès premium démarre
          tout de suite pour 10&nbsp;jours d’essai. Ensuite, factures, moyen de
          paiement et résiliation se gèrent depuis&nbsp;<a href="/compte/"
            >votre espace</a
          >.
        </p>
        <div class="el-subscribe__actions">
          <a
            class="el-subscribe__secondary"
            href="/login/?redirect=/compte/"
            >Déjà abonné&nbsp;? Connexion</a
          >
        </div>
      </section>

      <section class="el-subscribe__tools" aria-labelledby="el-subscribe-tools">
        <h3 id="el-subscribe-tools" class="el-subscribe__block-title">
          Aussi par ElectronLibre
        </h3>
        <p class="el-subscribe__tools-note">
          Découvrez aussi nos autres outils, autour de la veille et de
          l’information.
        </p>
        <div class="el-subscribe__tools-grid">
          <a
            class="el-subscribe__tool el-subscribe__tool--desinfo"
            href="https://desinfo.electronlibre.info/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="el-subscribe__tool-name">Observatoire de la désinformation</span>
            <span class="el-subscribe__tool-pitch"
              >Palmarès roulant fondé sur les Community Notes utiles.</span
            >
            <span class="el-subscribe__tool-cta">Voir le palmarès →</span>
          </a>
          <a
            class="el-subscribe__tool el-subscribe__tool--geo"
            href="https://geo.electronlibre.info/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="el-subscribe__tool-eyebrow">Veille IA</span>
            <span class="el-subscribe__tool-name">GEO</span>
            <span class="el-subscribe__tool-pitch"
              >Comment les IA citent et classent marques, médias, marchés.</span
            >
            <span class="el-subscribe__tool-cta">Ouvrir GEO →</span>
          </a>
        </div>
      </section>

      <div class="el-subscribe__partners">
        <h3 class="el-subscribe__block-title">Ils nous font confiance</h3>
        <img
          src="/images/logo-partners.png"
          alt="Logos des organisations partenaires et abonnées"
          width="880"
          height="384"
          loading="lazy"
          decoding="async"
        />
      </div>

      <p class="el-subscribe__foot">
        Une question ?
        <a href={mailtoQuestion}>Contactez-nous</a>
        ·
        <a href="/">Retour à l’accueil</a>
      </p>
    </article>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById("el-checkout-form");
    if (!form) return;
    var err = document.getElementById("el-checkout-error");
    var btn = document.getElementById("el-checkout-btn");
    var params = new URLSearchParams(location.search);
    if (params.get("checkout") === "cancel") {
      err.textContent =
        "Paiement annulé. Vous pouvez réessayer quand vous voulez.";
      err.hidden = false;
    }

    fetch("/api/billing/config", { credentials: "same-origin" })
      .then(function (r) {
        return r.json();
      })
      .then(function (cfg) {
        if (!btn) return;
        if (cfg && cfg.enabled) {
          btn.disabled = false;
          btn.textContent = "Je m'abonne";
        } else {
          btn.disabled = true;
          btn.textContent = "Bientôt";
        }
      })
      .catch(function () {
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Bientôt";
        }
      });

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (btn && btn.disabled) return;
      err.hidden = true;
      var given = String(
        (form.elements["given-name"] && form.elements["given-name"].value) ||
          ""
      ).trim();
      var family = String(
        (form.elements["family-name"] && form.elements["family-name"].value) ||
          ""
      ).trim();
      var email = String(form.email.value || "").trim().toLowerCase();
      var website = String(form.website.value || "").trim();
      if (!given || given.length < 2) {
        err.textContent = "Indiquez votre prénom.";
        err.hidden = false;
        return;
      }
      if (!family || family.length < 2) {
        err.textContent = "Indiquez votre nom.";
        err.hidden = false;
        return;
      }
      if (!email || email.indexOf("@") < 1) {
        err.textContent = "E-mail invalide.";
        err.hidden = false;
        return;
      }
      btn.disabled = true;
      btn.textContent = "Redirection…";
      try {
        var res = await fetch("/api/billing/checkout", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            first_name: given,
            last_name: family,
            name: given + " " + family,
            email: email,
            website: website,
            newsletter_opt_in: true,
          }),
        });
        var data = await res.json().catch(function () {
          return {};
        });
        if (!res.ok) {
          err.textContent =
            data.error || "Impossible de démarrer le paiement.";
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = "Je m'abonne";
          return;
        }
        if (data.url) {
          location.href = data.url;
          return;
        }
        err.textContent = "Réponse inattendue.";
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = "Je m'abonne";
      } catch (ex) {
        err.textContent = "Erreur réseau. Réessayez.";
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = "Je m'abonne";
      }
    });
  })();
</script>
