---
/**
 * Carte éditoriale — markup aligné template-parts/content.php (WP).
 * variant="related" : titre + catégorie + extrait uniquement.
 */
import LockIcon from "./LockIcon.astro";
import KeywordTags from "./KeywordTags.astro";
import {
  type Article,
  articlePath,
  isFreeArticle,
  formatArchiveDate,
  articleDisplayKeywords,
  KEYWORDS_LIMIT_CARD,
  trimExcerpt,
} from "../lib/articles";

interface Props {
  article: Article;
  featured?: boolean;
  variant?: "default" | "related";
}

const { article, featured = false, variant = "default" } = Astro.props;
const related = variant === "related";
const d = article.data;
const href = articlePath(article);
const dateLabel = formatArchiveDate(d.date);
const excerpt = trimExcerpt(d.excerpt, featured ? 55 : related ? 32 : 28);
// Hero : tous les tags WP ; grille : limite compacte
const keywords = related
  ? []
  : articleDisplayKeywords(article, featured ? 0 : KEYWORDS_LIMIT_CARD);
const cats = d.categories.map((slug, i) => ({
  slug,
  name: d.category_names[i] || slug,
}));
---

<article
  class:list={[
    "el-home-card",
    featured && "el-home-card--featured",
    related && "el-home-card--related",
  ]}
>
  <div class="news-snippet">
    {
      !related && (
        <div class="ihead info">
          <ul class="list-inline">
            <li>
              <time datetime={d.date.toISOString()}>{dateLabel}</time>
            </li>
            {d.author && (
              <li class="post-author">
                <span>{d.author}</span>
              </li>
            )}
          </ul>
        </div>
      )
    }

    <h3 class="news-title">
      {!related && !isFreeArticle(article) && <LockIcon />}
      <a href={href} rel="bookmark">{d.title}</a>
    </h3>

    <div class="summary">
      {
        cats.length > 0 && (
          <div class="category">
            {cats.map((c) => (
              <a href={`/articles/category/${c.slug}/`}>{c.name}</a>
            ))}
          </div>
        )
      }

      {excerpt && <div class="excerpt">{excerpt}</div>}

      <KeywordTags keywords={keywords} />
    </div>
  </div>
</article>
