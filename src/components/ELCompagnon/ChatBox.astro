---
/**
 * Formulaire chat EL Compagnon.
 * Lock abonné géré par /js/el-auth.js
 */
---

<div class="ai-chat-container">
  <form id="gpt4o-rag-form" class="ia-form">
    <div class="input-wrapper">
      <textarea
        id="question"
        name="question"
        placeholder="EL Compagnon : Que voulez-vous savoir ?"
        required
      ></textarea>
      <button type="button" id="reset-question" class="input-clear-btn" title="Effacer">✕</button>
    </div>
    <button type="submit" id="submit-question" class="gpt4o-btn gpt4o-btn--submit">Envoyer</button>
  </form>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const textarea = document.getElementById("question");
    if (textarea) {
      textarea.addEventListener("input", function () {
        textarea.style.height = "auto";
        textarea.style.height = textarea.scrollHeight + "px";
      });
    }
    const resetBtn = document.getElementById("reset-question");
    if (resetBtn && textarea) {
      resetBtn.addEventListener("click", function () {
        textarea.value = "";
        textarea.style.height = "auto";
        textarea.focus();
      });
    }
  });
</script>
