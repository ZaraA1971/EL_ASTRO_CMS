---
/**
 * Tiroir EL Compagnon — markup fidèle au header.php WP.
 */
import ChatBox from "./ChatBox.astro";
---

<div id="ia-drawer-overlay" class="ia-drawer-overlay" aria-hidden="true"></div>
<div id="ia-drawer" class="ia-drawer" aria-hidden="true">
  <div id="ia-drawer-content" class="ia-drawer-content">
    <div id="ia-tools-actions" class="ia-tools-actions">
      <button type="button" data-ia-action="copy" aria-label="Copier la réponse IA">
        <img src="/icons/sf/doc-on-doc.svg" alt="Copier" class="ia-icon-btn" />
      </button>
      <button type="button" data-ia-action="email" aria-label="Envoyer la réponse IA par email">
        <img src="/icons/sf/envelope.svg" alt="Email" class="ia-icon-btn" />
      </button>
      <button type="button" data-ia-action="share-x" aria-label="Partager sur X">
        <img src="/icons/sf/square-and-arrow-up.svg" alt="Partager sur X" class="ia-icon-btn" />
      </button>
    </div>
    <ChatBox />
    <div id="gpt-stream"></div>
    <div id="final-answer"></div>
  </div>
</div>
