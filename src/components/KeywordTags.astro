---
/**
 * Liste de tags / mots-clés cliquables (cards, sujets liés).
 */
import { displayKeyword, tagPath, type LangCode } from "../lib/articles";

interface Props {
  keywords: string[];
  class?: string;
  linkTitle?: string;
  lang?: LangCode;
}

const {
  keywords,
  class: className = "tags",
  linkTitle,
  lang = "fr",
} = Astro.props;
---

{
  keywords.length > 0 && (
    <div class={className}>
      {keywords.map((kw) => (
        <a href={tagPath(kw, lang)} title={linkTitle || undefined}>
          {displayKeyword(kw)}
        </a>
      ))}
    </div>
  )
}
