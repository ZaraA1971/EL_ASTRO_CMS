---
import LockIcon from "./LockIcon.astro";
import type { LangCode } from "../lib/articles";
import { ASSET_V } from "../lib/assets";

interface Props {
  lang?: LangCode;
}

const { lang = "fr" } = Astro.props;
const en = lang === "en";

const sectionTitle = en ? "Tools" : "Outils";
---

<aside
  class="el-home-tools"
  aria-labelledby="el-home-tools-title"
  data-asset-v={ASSET_V}
>
  <header class="el-section-head el-home-tools__head">
    <h2 id="el-home-tools-title" class="el-section-head__title el-home-tools__kicker">
      {sectionTitle}
    </h2>
  </header>

  <div class="el-home-tools__stack">
    <div
      id="el-compagnon"
      class="el-home-tools__panel el-home-tools__panel--compagnon"
      data-el-premium-tool="rag"
      data-open="false"
    >
      <button
        type="button"
        id="el-compagnon-toggle"
        class="el-compagnon__toggle"
        aria-expanded="false"
        aria-controls="el-compagnon-content"
      >
        <div class="el-home-tools__panel-body el-compagnon__head">
          <div class="el-compagnon__brand">
            <svg
              class="el-compagnon__sparkle"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
            >
              <g fill="#2f6dfb">
                <path d="M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5z"></path>
                <path d="M20 4l1 2.5 2.5 1-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1 1-2.5z"></path>
                <path d="M5 15l0.7 2L8 18l-2.3 0.7L5 21l-0.7-2.3L2 18l2.3-0.7L5 15z"></path>
              </g>
            </svg>
            <span class="el-compagnon__brand-label">IA</span>
            <LockIcon />
          </div>
          <p class="el-home-tools__pitch">
            {
              en
                ? "Ask ElectronLibre’s archive. Answers with sources, on this page."
                : "Interrogez les archives ElectronLibre. Réponses sourcées, ici."
            }
          </p>
          <span class="el-home-tools__cta el-home-tools__cta--compagnon" data-compagnon-cta>
            {en ? "Open EL Compagnon" : "Ouvrir EL Compagnon"}
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </button>

      <div
        id="el-compagnon-content"
        class="el-compagnon__body"
        hidden
        aria-hidden="true"
      >
        <div class="el-compagnon__toolbar">
          <div id="ia-tools-actions" class="ia-tools-actions hidden">
            <button type="button" data-ia-action="copy" aria-label="Copier la réponse IA">
              <img src="/icons/sf/doc-on-doc.svg" alt="" class="ia-icon-btn" width="18" height="18" />
            </button>
            <button type="button" data-ia-action="email" aria-label="Envoyer la réponse IA par email">
              <img src="/icons/sf/envelope.svg" alt="" class="ia-icon-btn" width="18" height="18" />
            </button>
            <button type="button" data-ia-action="share-x" aria-label="Partager sur X">
              <img
                src="/icons/sf/square-and-arrow-up.svg"
                alt=""
                class="ia-icon-btn"
                width="18"
                height="18"
              />
            </button>
          </div>
        </div>

        <div class="ai-chat-container">
          <form id="gpt4o-rag-form" class="ia-form">
            <div class="input-wrapper">
              <textarea
                id="question"
                name="question"
                placeholder={
                  en
                    ? "EL Compagnon: what do you want to know?"
                    : "EL Compagnon : Que voulez-vous savoir ?"
                }
                required
                rows="3"
              ></textarea>
              <button type="button" id="reset-question" class="input-clear-btn" title="Effacer">
                ✕
              </button>
            </div>
            <button type="submit" id="submit-question" class="gpt4o-btn gpt4o-btn--submit">
              {en ? "Ask" : "Envoyer"}
            </button>
          </form>
        </div>

        <div id="gpt-stream" class="rag-stream-text" aria-live="polite"></div>
        <div id="final-answer" class="final-answer"></div>
      </div>
    </div>

    <a
      class="el-home-tools__panel el-home-tools__panel--geo"
      href="https://geo.electronlibre.info/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="el-home-tools__panel-glow" aria-hidden="true"></div>
      <div class="el-home-tools__panel-grid" aria-hidden="true"></div>
      <div class="el-home-tools__panel-body">
        <p class="el-home-tools__eyebrow">
          {en ? "AI monitoring" : "Veille IA"}
        </p>
        <h3 class="el-home-tools__name">GEO</h3>
        <p class="el-home-tools__pitch">
          {
            en
              ? "How AI systems cite and rank brands, media, markets."
              : "Comment les IA citent et classent marques, médias, marchés."
          }
        </p>
        <span class="el-home-tools__cta el-home-tools__cta--geo">
          {en ? "Open GEO" : "Ouvrir GEO"}
          <span aria-hidden="true">→</span>
        </span>
      </div>
      <div class="el-home-tools__viz el-home-tools__viz--geo" aria-hidden="true">
        <div class="el-home-tools__geo-card">
          <div class="el-home-tools__geo-body">
            <svg class="el-home-tools__geo-spark" viewBox="0 0 120 40" fill="none">
              <path
                d="M2 30 L22 26 L42 28 L62 14 L82 18 L118 6"
                stroke="#34d399"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <path
                d="M2 34 L22 32 L42 29 L62 26 L82 24 L118 20"
                stroke="#22d3ee"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                opacity="0.85"></path>
            </svg>
            <svg class="el-home-tools__geo-gravity" viewBox="0 0 56 56" fill="none">
              <circle cx="28" cy="28" r="24" stroke="#3f3f46" stroke-width="1"></circle>
              <circle cx="28" cy="28" r="14" stroke="#3f3f46" stroke-width="1"></circle>
              <line x1="28" y1="28" x2="40" y2="14" stroke="#34d399" stroke-width="1" opacity="0.75"></line>
              <line x1="28" y1="28" x2="42" y2="34" stroke="#22d3ee" stroke-width="1" opacity="0.7"></line>
              <circle cx="28" cy="28" r="2.4" fill="#a1a1aa"></circle>
              <circle cx="40" cy="14" r="2.6" fill="#34d399"></circle>
              <circle cx="42" cy="34" r="2.3" fill="#22d3ee"></circle>
            </svg>
          </div>
          <div class="el-home-tools__geo-bar" role="presentation">
            <i style="width:36%"></i>
            <i style="width:28%"></i>
            <i style="width:20%"></i>
            <i style="width:16%"></i>
          </div>
        </div>
      </div>
    </a>

    <a
      class="el-home-tools__panel el-home-tools__panel--desinfo"
      href="https://desinfo.electronlibre.info/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="el-home-tools__panel-body">
        <h3 class="el-home-tools__name">
          {
            en
              ? "Disinformation Observatory"
              : "Observatoire de la désinformation"
          }
        </h3>
        <p class="el-home-tools__pitch">
          {
            en
              ? "Rolling ranking from helpful Community Notes on X."
              : "Palmarès roulant fondé sur les Community Notes utiles."
          }
        </p>
        <span class="el-home-tools__cta el-home-tools__cta--desinfo">
          {en ? "Open ranking" : "Voir le palmarès"}
          <span aria-hidden="true">→</span>
        </span>
      </div>
      <div class="el-home-tools__viz el-home-tools__viz--desinfo" aria-hidden="true">
        <div class="el-home-tools__desinfo-ui">
          <div class="el-home-tools__desinfo-tabs">
            <span class="is-active">{en ? "Media" : "Médias"}</span>
            <span>7d</span>
          </div>
          <ol class="el-home-tools__rank">
            <li><span>01</span><em>CN / Posts</em><b>0.42</b></li>
            <li><span>02</span><em>{en ? "Media A" : "Média A"}</em><b>0.31</b></li>
            <li><span>03</span><em>{en ? "Media B" : "Média B"}</em><b>0.27</b></li>
          </ol>
        </div>
      </div>
    </a>
  </div>
</aside>

<script is:inline>
  (function () {
    var loaded = false;
    var loading = null;
    var pendingOpen = false;
    var root = document.querySelector(".el-home-tools");
    var assetV =
      (root && root.getAttribute("data-asset-v")) || "20260726critpath1";

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var s = document.createElement("script");
        s.src = src;
        s.async = false;
        s.onload = function () {
          resolve();
        };
        s.onerror = function () {
          reject(new Error("Failed to load " + src));
        };
        document.body.appendChild(s);
      });
    }

    function loadIaChain() {
      if (loaded) return Promise.resolve();
      if (loading) return loading;
      var v = assetV;
      loading = loadScript("/js/ia-compagnon.js?v=" + v)
        .then(function () {
          return loadScript("/js/ia-tools.js?v=" + v);
        })
        .then(function () {
          return loadScript("/js/rag.js?v=" + v);
        })
        .then(function () {
          loaded = true;
          var textarea = document.getElementById("question");
          if (textarea && !textarea.dataset.elAutosize) {
            textarea.dataset.elAutosize = "1";
            textarea.addEventListener("input", function () {
              textarea.style.height = "auto";
              textarea.style.height =
                Math.min(textarea.scrollHeight, 160) + "px";
            });
          }
          if (pendingOpen && window.ELCompagnon && window.ELCompagnon.open) {
            pendingOpen = false;
            window.ELCompagnon.open();
          }
        })
        .catch(function (err) {
          loading = null;
          console.error("[el] ia scripts", err);
        });
      return loading;
    }

    function onCompagnonIntent(e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (
        !t.closest("#el-compagnon-toggle") &&
        !t.closest("[data-compagnon-cta]")
      ) {
        return;
      }
      if (loaded) return;
      e.preventDefault();
      e.stopPropagation();
      pendingOpen = true;
      loadIaChain();
    }

    document.addEventListener("click", onCompagnonIntent, true);

    function scheduleIdle() {
      if (typeof requestIdleCallback === "function") {
        requestIdleCallback(
          function () {
            loadIaChain();
          },
          { timeout: 2500 }
        );
      } else {
        setTimeout(loadIaChain, 1800);
      }
    }

    if (document.readyState === "complete") scheduleIdle();
    else window.addEventListener("load", scheduleIdle);
  })();
</script>
