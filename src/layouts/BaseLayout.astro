---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieYes from "../components/CookieYes.astro";
import OneSignalInit from "../components/OneSignalInit.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import GoatCounter from "../components/GoatCounter.astro";
import { ASSET_V } from "../lib/assets";
import { chrome, hreflang, pagePath } from "@el/i18n-seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "fr" | "en";
  canonical?: string;
  noindex?: boolean;
  bodyClass?: string;
  ogType?: string;
  /** URL absolue — absente = pas de vignette (évite le thumb vide sur X). */
  ogImage?: string;
  /** Chemins des versions linguistiques (FR/EN). */
  alternates?: { fr?: string; en?: string };
  hreflangContext?: "home" | "search" | "category" | "tag" | "article" | "page";
  hreflangOpts?: { slug?: string; page?: number };
}

const {
  title,
  description,
  lang = "fr",
  canonical,
  noindex = false,
  bodyClass = "",
  ogType = "website",
  ogImage = "",
  alternates = {},
  hreflangContext = "page",
  hreflangOpts = {},
} = Astro.props;

const assetV = ASSET_V;
const canonicalUrl =
  canonical ||
  new URL(Astro.url.pathname, Astro.site || "https://electronlibre.info").href;
const imageUrl = String(ogImage || "").trim();
const twitterCard = imageUrl ? "summary_large_image" : "summary";
const pageTitle = title || chrome("homeTitle", lang);
const pageDescription = description || chrome("homeDescription", lang);
const altFr = alternates.fr || pagePath("home", "fr");
const altEn = alternates.en || pagePath("home", "en");
const hreflangLinks = hreflang(
  {
    lang,
    path: canonicalUrl,
    alternates: { fr: alternates.fr, en: alternates.en },
  },
  hreflangContext,
  hreflangOpts
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {
      hreflangLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ElectronLibre" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    {
      lang === "en" ? (
        <meta property="og:locale:alternate" content="fr_FR" />
      ) : (
        <meta property="og:locale:alternate" content="en_US" />
      )
    }
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{pageTitle}</title>
    <CookieYes />
    <link rel="stylesheet" href={`/css/el/el-tokens.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/el-reset.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/el-global.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/header.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/ia-chat.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/el-footer.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/el-article.css?v=${assetV}`} />
    <link rel="stylesheet" href={`/css/el/single.css?v=${assetV}`} />
    <OneSignalInit />
    <GoogleAnalytics />
    <GoatCounter />
  </head>
  <body class={bodyClass}>
    <a class="skip-link screen-reader-text" href="#primary">{chrome("skip", lang)}</a>
    <Header lang={lang} alternates={{ fr: altFr, en: altEn }} />
    <main id="primary">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
